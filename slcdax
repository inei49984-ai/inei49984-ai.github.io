    <script>
    /* ====================================================
       BACKGROUND — lightweight: stars + static nebula + geometry
    ==================================================== */
    (function() {
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');
        let W, H;

        function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
        resize();
        window.addEventListener('resize', resize);

        // Stars — parallax layers, slow drift
        const STAR_COUNT = 130;
        const stars = Array.from({ length: STAR_COUNT }, () => {
            const layer = Math.random(); // 0=far/slow, 1=near/fast
            return {
                x: Math.random(), y: Math.random(),
                r: 0.3 + layer * 1.8,
                a: 0.35 + layer * 0.55,
                tw: Math.random() * Math.PI * 2,
                vx: (Math.random() - 0.5) * (0.000015 + layer * 0.00008),
                vy: (Math.random() - 0.5) * (0.000010 + layer * 0.00005),
                layer
            };
        });

        // Shooting stars — multiple can be active at once
        const shoots = [];
        let nextShoot = 1000 + Math.random() * 2000;

        // Geometry nodes — fewer, no shadowBlur
        const GEO = Array.from({ length: 7 }, () => ({
            x: Math.random(), y: Math.random(),
            vx: (Math.random() - 0.5) * 0.00010,
            vy: (Math.random() - 0.5) * 0.00010
        }));

        // Draw nebula once onto offscreen canvas (static, no per-frame redraw)
        const nebulaCanvas = document.createElement('canvas');
        function bakeNebula() {
            nebulaCanvas.width = W; nebulaCanvas.height = H;
            const nc = nebulaCanvas.getContext('2d');
            const blobs = [
                { x: 0.18, y: 0.25, rx: 0.32, r: 255, g: 60,  b: 120, a: 0.04 },
                { x: 0.78, y: 0.55, rx: 0.28, r: 60,  g: 80,  b: 255, a: 0.045},
                { x: 0.50, y: 0.82, rx: 0.38, r: 0,   g: 200, b: 255, a: 0.035},
                { x: 0.85, y: 0.15, rx: 0.20, r: 120, g: 0,   b: 255, a: 0.03 }
            ];
            blobs.forEach(n => {
                const px = n.x * W, py = n.y * H, rad = n.rx * W;
                const g = nc.createRadialGradient(px, py, 0, px, py, rad);
                g.addColorStop(0,   `rgba(${n.r},${n.g},${n.b},${n.a})`);
                g.addColorStop(0.5, `rgba(${n.r},${n.g},${n.b},${n.a * 0.35})`);
                g.addColorStop(1,   'rgba(0,0,0,0)');
                nc.fillStyle = g;
                nc.beginPath();
                nc.arc(px, py, rad, 0, Math.PI * 2);
                nc.fill();
            });
        }
        bakeNebula();
        window.addEventListener('resize', bakeNebula);

        function loop(t) {
            // bg
            ctx.fillStyle = '#020510';
            ctx.fillRect(0, 0, W, H);

            // nebula (single drawImage — cheap)
            ctx.drawImage(nebulaCanvas, 0, 0);

            // ---- Stars: drift + twinkle ----
            nextShoot -= 16;
            if (nextShoot <= 0) {
                // random spawn edge: top, left, or top-right corner area
                const edge = Math.floor(Math.random() * 3);
                let sx, sy, angle;
                if (edge === 0) {
                    // top edge → moves down-right
                    sx = Math.random();
                    sy = 0;
                    angle = (20 + Math.random() * 40) * Math.PI / 180;
                } else if (edge === 1) {
                    // left edge → moves right-down
                    sx = 0;
                    sy = Math.random() * 0.6;
                    angle = (-20 + Math.random() * 40) * Math.PI / 180;
                } else {
                    // top-right → moves down-left
                    sx = 0.6 + Math.random() * 0.4;
                    sy = 0;
                    angle = Math.PI - (20 + Math.random() * 40) * Math.PI / 180;
                }
                const speed = 0.009 + Math.random() * 0.008;
                shoots.push({
                    x: sx, y: sy,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    life: 1.0, tail: [],
                    bright: 0.6 + Math.random() * 0.4
                });
                nextShoot = 900 + Math.random() * 1800;
            }

            stars.forEach(s => {
                // drift
                s.x += s.vx; s.y += s.vy;
                if (s.x < 0) s.x = 1; if (s.x > 1) s.x = 0;
                if (s.y < 0) s.y = 1; if (s.y > 1) s.y = 0;

                const tw = 0.55 + Math.sin(t * 0.0009 + s.tw) * 0.45;
                ctx.globalAlpha = s.a * tw;
                ctx.fillStyle = s.r > 1.8 ? '#cceeff' : '#ffffff';
                ctx.beginPath();
                ctx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);
                ctx.fill();
            });

            // ---- Shooting stars ----
            for (let i = shoots.length - 1; i >= 0; i--) {
                const sh = shoots[i];
                sh.tail.push({ x: sh.x, y: sh.y });
                if (sh.tail.length > 14) sh.tail.shift();
                sh.x += sh.vx; sh.y += sh.vy;
                sh.life -= 0.010;
                if (sh.life <= 0 || sh.x < -0.1 || sh.x > 1.1 || sh.y > 1.1) { shoots.splice(i, 1); continue; }

                sh.tail.forEach((pt, idx) => {
                    const prog = idx / sh.tail.length;
                    ctx.globalAlpha = prog * sh.life * sh.bright * 0.75;
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = prog * 2.0;
                    if (idx > 0) {
                        const prev = sh.tail[idx - 1];
                        ctx.beginPath();
                        ctx.moveTo(prev.x * W, prev.y * H);
                        ctx.lineTo(pt.x * W, pt.y * H);
                        ctx.stroke();
                    }
                });
                ctx.globalAlpha = sh.life * sh.bright;
                ctx.fillStyle = '#aaeeff';
                ctx.beginPath();
                ctx.arc(sh.x * W, sh.y * H, 1.8, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.globalAlpha = 1;

            // geometry lines — batch all into one path per alpha level is expensive;
            // instead just iterate but NO save/restore, NO shadowBlur
            GEO.forEach(n => {
                n.x += n.vx; n.y += n.vy;
                if (n.x < 0) n.x = 1; if (n.x > 1) n.x = 0;
                if (n.y < 0) n.y = 1; if (n.y > 1) n.y = 0;
            });
            const DIST = 0.22;
            for (let i = 0; i < GEO.length; i++) {
                for (let j = i + 1; j < GEO.length; j++) {
                    const a = GEO[i], b = GEO[j];
                    const dx = a.x - b.x, dy = a.y - b.y;
                    const d = Math.sqrt(dx * dx + dy * dy);
                    if (d < DIST) {
                        ctx.globalAlpha = (1 - d / DIST) * 0.15;
                        ctx.strokeStyle = '#00d2ff';
                        ctx.lineWidth = 0.5;
                        ctx.beginPath();
                        ctx.moveTo(a.x * W, a.y * H);
                        ctx.lineTo(b.x * W, b.y * H);
                        ctx.stroke();
                    }
                }
            }
            ctx.globalAlpha = 1;

            requestAnimationFrame(loop);
        }
        requestAnimationFrame(loop);
    })();

    /* ====================================================
       UI CONSOLE
    ==================================================== */
    const globalMenuBtn = document.getElementById('global-menu-btn');
    const uiOverlay = document.getElementById('ui-overlay');
    const uiCloseBtn = document.getElementById('ui-close-btn');

    globalMenuBtn.addEventListener('click', () => uiOverlay.classList.add('open'));
    uiCloseBtn.addEventListener('click', () => { uiOverlay.classList.remove('open'); });
    uiOverlay.addEventListener('click', e => {
        if (e.target === uiOverlay) { uiOverlay.classList.remove('open'); }
    });

    /* ====================================================
       LUA FILES — download or view raw
    ==================================================== */
    const LUA_FILES = {
        kyojin: {
            filename: '巨人の時代.lua',
            content: 'loadstring(game:HttpGet("https://raw.githubusercontent.com/inei49984-ai/gozila-game-roblox/refs/heads/main/gizlia%20sciprt.lua"))()\n'
        },
        unrikurin: {
            filename: 'うんりくりん.lua',
            content: 'loadstring(game:HttpGet("https://raw.githubusercontent.com/inei49984-ai/poopzous/refs/heads/main/unchikhub.lua"))()\n'
        }
    };

    function downloadLua(key) {
        const file = LUA_FILES[key];
        if (!file) return;
        const bom = new Uint8Array([0xEF, 0xBB, 0xBF]);
        const blob = new Blob([bom, file.content], { type: 'text/plain;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = file.filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(a.href);
    }

    function showRawLua(key) {
        const file = LUA_FILES[key];
        if (!file) return;
        const blob = new Blob([file.content], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        window.open(url, '_blank');
        // Blob URL のクリーンアップ（新しいタブが読み込む時間を少し確保）
        setTimeout(() => URL.revokeObjectURL(url), 30000);
    }

    document.querySelectorAll('.file-card-actions .action-trigger').forEach(btn => {
        btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-file');
            const mode = btn.getAttribute('data-mode');
            if (mode === 'download') downloadLua(key);
            else if (mode === 'raw') showRawLua(key);
        });
    });
    </script>
