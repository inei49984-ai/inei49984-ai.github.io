<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>slcdax</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Space+Grotesk:wght@400;900&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Space Grotesk', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: #020510;
            color: #e2e8f0;
            position: relative;
            min-height: 180vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* ====================================================
           BACKGROUND CANVAS
        ==================================================== */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* ====================================================
           HAMBURGER
        ==================================================== */
        .header-menu-trigger {
            position: fixed;
            top: 30px;
            right: 40px;
            width: 40px;
            height: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 6px;
            background: none;
            border: none;
            cursor: pointer;
            z-index: 1500;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            overflow: visible;
            transition: transform 0.2s ease;
        }

        .header-menu-trigger::before {
            content: '';
            position: absolute;
            inset: -14px;
            border-radius: 16px;
            background: transparent;
            border: 1.5px solid rgba(0, 210, 255, 0.6);
            transform: scale(0.7);
            opacity: 0;
            transition: transform 0.2s ease, opacity 0.2s ease;
            z-index: -1;
        }

        .menu-bar {
            height: 2px;
            background-color: #ffffff;
            transition: background-color 0.2s ease, width 0.2s ease;
            border-radius: 2px;
        }

        .bar-top { width: 28px; }
        .bar-mid { width: 20px; }
        .bar-bot { width: 25px; }

        .header-menu-trigger:active {
            transform: scale(0.9);
        }
        .header-menu-trigger:active .menu-bar {
            background-color: #00d2ff;
        }

        @media (pointer: fine) {
            .header-menu-trigger:hover {
                transform: scale(1.12);
            }
            .header-menu-trigger:hover::before {
                transform: scale(1);
                opacity: 1;
            }
            .header-menu-trigger:hover .menu-bar {
                background-color: #00d2ff;
                width: 32px;
            }
        }


        /* ====================================================
           UI CONSOLE
        ==================================================== */
        .ui-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            background: rgba(2, 5, 16, 0.75);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            z-index: 2000;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .ui-overlay.open { opacity: 1; pointer-events: auto; }

        .ui-console {
            width: 90%;
            max-width: 680px;
            background: #080f22;
            border: 1px solid rgba(0, 210, 255, 0.25);
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 210, 255, 0.1);
            padding: 30px;
            position: relative;
            transform: scale(0.92) translateY(20px);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .ui-overlay.open .ui-console { transform: scale(1) translateY(0); }

        .ui-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .ui-title {
            font-size: 14px;
            font-weight: bold;
            color: #00d2ff;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .ui-close-btn {
            background: none;
            border: none;
            color: #94a3b8;
            font-size: 20px;
            cursor: pointer;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            padding: 6px;
            transition: color 0.2s, transform 0.15s ease;
        }

        .ui-close-btn:active {
            color: #ffffff;
            transform: scale(0.85);
        }

        @media (pointer: fine) {
            .ui-close-btn:hover { color: #ffffff; }
        }

        .ai-input-container {
            width: 100%;
            background: rgba(2, 5, 16, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 18px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            position: relative;
            box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.5);
        }

        .ai-prompt-placeholder {
            font-size: 20px;
            font-weight: 500;
            color: #ffffff;
            letter-spacing: 0.5px;
            line-height: 1.4;
        }

        .ai-action-bar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 14px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 15px;
        }

        .brand-icon-link {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #0f1a30;
            border: 1px solid rgba(0, 210, 255, 0.2);
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
            text-decoration: none;
        }

        .brand-icon-link svg {
            width: 22px;
            height: 22px;
            fill: #00d2ff;
            transition: fill 0.2s ease, transform 0.2s ease;
        }

        .brand-icon-link:active {
            background: rgba(0, 210, 255, 0.15);
            border-color: rgba(0, 210, 255, 0.8);
            box-shadow: 0 0 16px rgba(0, 210, 255, 0.4);
            transform: scale(0.88);
        }

        @media (pointer: fine) {
            .brand-icon-link:hover {
                background: rgba(0, 210, 255, 0.12);
                border-color: rgba(0, 210, 255, 0.7);
                box-shadow: 0 0 14px rgba(0, 210, 255, 0.35);
            }
            .brand-icon-link:hover svg {
                transform: scale(1.18);
            }
        }

        /* ====================================================
           SECTIONS
        ==================================================== */
        .hero-section {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            padding: 0 20px;
            z-index: 10;
        }

        .brand-huge {
            font-size: clamp(65px, 16vw, 220px);
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -3px;
            line-height: 0.85;
            text-transform: lowercase;
            z-index: 10;
            text-align: center;
            transition: transform 0.25s ease;
            touch-action: manipulation;
            text-shadow: 0 0 80px rgba(0, 210, 255, 0.15);
        }

        @media (pointer: fine) {
            .brand-huge:hover {
                transform: scale(1.05);
            }
        }

        .brand-huge span {
            color: #00d2ff;
            text-shadow: 0 0 30px rgba(0, 210, 255, 0.6), 0 0 60px rgba(0, 210, 255, 0.3);
        }

        .scroll-indicator {
            position: absolute;
            bottom: 40px;
            font-size: 11px;
            letter-spacing: 4px;
            color: #24354b;
            text-transform: uppercase;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.3; transform: translateY(0); }
            50% { opacity: 1; transform: translateY(6px); }
        }

        .content-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 100px 24px;
            text-align: center;
            z-index: 10;
            position: relative;
        }

        .site-description {
            font-size: clamp(16px, 4vw, 22px);
            color: #94a3b8;
            max-width: 650px;
            line-height: 1.8;
            letter-spacing: 1px;
            margin-bottom: 50px;
            font-weight: 400;
        }

        /* ---- File cards (each script gets its own card with 2 actions) ---- */
        .file-card-group {
            display: flex;
            gap: 28px;
            flex-wrap: wrap;
            justify-content: center;
            max-width: 900px;
        }

        .file-card {
            background: rgba(0, 210, 255, 0.02);
            border: 1px solid rgba(0, 210, 255, 0.25);
            border-radius: 20px;
            padding: 24px 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            min-width: 230px;
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.06);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            will-change: transform;
        }

        .file-card:active {
            transform: scale(0.97);
            box-shadow: 0 0 18px rgba(0, 210, 255, 0.25);
        }

        @media (pointer: fine) {
            .file-card:hover {
                transform: scale(1.07);
                box-shadow: 0 0 18px rgba(0, 210, 255, 0.3);
            }
        }

        .file-card-title {
            font-size: 15px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 1px;
        }

        .file-card-sub {
            font-size: 11px;
            color: #5b7290;
            letter-spacing: 1px;
            margin-top: -10px;
        }

        .file-card-actions {
            display: flex;
            gap: 12px;
        }

        .service-action-group {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
            max-width: 800px;
        }

        .action-trigger {
            background: rgba(0, 210, 255, 0.02);
            color: #00d2ff;
            border: 1px solid #00d2ff;
            padding: 16px 36px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.1);
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            will-change: transform;
        }

        .action-trigger:active {
            transform: scale(0.93);
            box-shadow: 0 0 22px rgba(0, 210, 255, 0.45);
            background: rgba(0, 210, 255, 0.1);
        }

        @media (pointer: fine) {
            .action-trigger:hover {
                transform: scale(1.06);
                box-shadow: 0 0 16px rgba(0, 210, 255, 0.4);
            }
        }

        .action-trigger.small {
            padding: 10px 20px;
            font-size: 12px;
        }

        .action-trigger.raw-variant {
            color: #94a3b8;
            border-color: #4a5b73;
            box-shadow: none;
        }

        .footer-signature-container {
            margin-top: auto;
            width: 100%;
            padding: 60px 0 50px 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: rgba(2, 5, 16, 0.6);
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            position: relative;
            z-index: 10;
        }

        .brand-signature {
            font-family: 'Alex Brush', cursive;
            font-size: clamp(38px, 6vw, 65px);
            color: #94a3b8;
            font-weight: 300;
            letter-spacing: 1px;
            text-align: center;
            opacity: 0.7;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .signature-sub {
            font-size: 10px;
            color: #24354b;
            letter-spacing: 6px;
            text-transform: uppercase;
            margin-top: 10px;
            font-weight: 500;
        }
    </style>
